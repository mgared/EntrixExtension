  "quickEntries": [
    {
      "durationMins": "60",
      "baseText": "Lobby walk-through completed (front entrance, desk area, seating, elevators).",
      "id": "lobbyWalk",
      "buttonLabel": "Lobby walk-through"
    },
    {
      "buttonLabel": "Package area checked",
      "baseText": "Package locker/receiving area checked and organized (overflow reviewed, area tidied).",
      "id": "packageRoom",
      "durationMins": "45"
    },
    {
