{
  "leasingOffice": {
    "regardingOptions": [
      "Packages / Deliveries",
      "Maintenance",
      "Lease",
      "Rent / Payments",
      "Keys / Fobs",
      "Parking / Garage",
      "Amenities",
      "Other"
    ],
    "staff": [
      "Property Manager",
      "Leasing Agent",
      "Resident Services",
      "Maintenance"
    ]
  },
  "propertyLabel": "The Franklin",
  "shiftOptions": [
    "11AM - 9PM"
  ],
  "version": 2,
  "defaultRoleId": "resident",
  "fieldDefs": {
    "lastName": {
      "label": "Last name",
      "placeholder": "Hesse",
      "type": "text"
    },
    "note": {
      "label": "Note",
      "placeholder": "extra details",
      "type": "text"
    },
    "storedBy": {
      "options": [
        "Courier",
        "Concierge"
      ],
      "label": "Packages stored by",
      "type": "select"
    },
    "vendorFor": {
      "options": [
        "Resident",
        "Company"
      ],
      "label": "Called by",
      "type": "select"
    },
    "scheduled": {
      "label": "Scheduled",
      "type": "boolean"
    },
    "companyName": {
      "label": "Company name",
      "placeholder": "(optional)",
      "type": "text"
    },
    "scheduledWith": {
      "label": "Scheduled with",
      "type": "select",
      "optionsFrom": "leasingOffice.staff"
    },
    "assistedStaff": {
      "label": "Assisted by",
      "type": "select",
      "optionsFrom": "leasingOffice.staff"
    },
    "regarding": {
      "label": "Regarding",
      "type": "select",
      "optionsFrom": "leasingOffice.regardingOptions"
    },
    "firstName": {
      "label": "First name",
      "placeholder": "Kaitlyn",
      "type": "text"
    },
    "isChrVendor": {
      "label": "CHR vendor?",
      "type": "boolean"
    },
    "requestedStaff": {
      "label": "Requested staff",
      "type": "select",
      "optionsFrom": "leasingOffice.staff"
    },
    "reasonId": {
      "label": "Reason",
      "type": "select"
    },
    "residentsName": {
      "label": "Resident name",
      "placeholder": "(optional)",
      "type": "text"
    },
    "customReason": {
      "label": "Other reason",
      "placeholder": "Type reason...",
      "type": "text"
    },
    "streetOrBuildingName": {
      "label": "Building",
      "placeholder": "The Franklin",
      "type": "text"
    },
    "unitOrStreetNumber": {
      "label": "Unit #",
      "placeholder": "1204",
      "type": "text"
    },
    "placedAt": {
      "options": [
        "Lockers",
        "Package Room",
        "Mailroom",
        "Overflow Room",
        "Front Desk",
        "Lobby Vestibule",
        "Delivery Table",
        "Sent Upstairs"
      ],
      "label": "Placed at",
      "type": "select"
    },
    "desc": {
      "label": "Description",
      "placeholder": "Write details...",
      "type": "text"
    },
    "desc2": {
      "label": "Second description",
      "placeholder": "more description...",
      "type": "text"
    },
    "cSmell": {
      "label": "Smell",
      "type": "boolean"
    },
    "cNoise": {
      "label": "Noise",
      "type": "boolean"
    },
    "cDamage": {
      "label": "Damage",
      "type": "boolean"
    },
    "cService": {
      "label": "Service",
      "type": "boolean"
    },
    "contactMethod": {
      "label": "Contact",
      "type": "select",
      "options": [
        "called in",
        "frontDesk"
      ]
    },
    "copyMade": {
      "label": "Copy Made",
      "type": "boolean"
    }
  },
  "roles": [
    {
      "fields": [
        "firstName",
        "lastName",
        "unitOrStreetNumber",
        "reasonId",
        "note"
      ],
      "id": "resident",
      "reasons": [
        {
          "label": "Missing package",
          "template": "to report a missing package.",
          "id": "missingPackage"
        },
        {
          "template": "to inform {desc}.",
          "id": "inform",
          "extraFields": [
            "desc"
          ],
          "label": "Inform desk"
        },
        {
          "label": "requestSendUp",
          "extraFields": [
            "desc"
          ],
          "id": "leftPackageForPickup",
          "template": "and requested {desc} be sent up, upon arrival."
        },
        {
          "label": "Complaint",
          "extraFields": [
            "desc",
            "cSmell",
            "cNoise",
            "cDamage",
            "cService"
          ],
          "template": "to complain that {desc}.",
          "id": "complain"
        },
        {
          "id": "parkingPass",
          "label": "Parking pass",
          "template": "to request a parking pass, pass issued and logged."
        },
        {
          "extraFields": [
            "desc",
            "desc2",
            "placedAt"
          ],
          "id": "dropForPickupLater",
          "template": "to drop a {desc} for {desc2} to pick up later, item placed at {placedAt}.",
          "label": "Drop item for pickup"
        },
        {
          "id": "pickupLeftItem",
          "template": "to pickup {desc} that was placed at {placedAt} after ID check.",
          "extraFields": [
            "desc",
            "placedAt"
          ],
          "label": "Pick up left item"
        },
        {
          "template": "to drop a rent check; {copyMadeText}; Placed at: {placedAt}.",
          "label": "Drop rent check",
          "id": "dropRentCheck",
          "extraFields": [
            "copyMade",
            "placedAt"
          ]
        },
        {
          "label": "Speak with staff",
          "id": "speakWithStaff",
          "template": "and requested to speak with {requestedStaff} regarding {desc}, {assistedStaff} was able to assist.",
          "extraFields": [
            "requestedStaff",
            "assistedStaff",
            "desc"
          ]
        },
        {
          "extraFields": [
            "assistedStaff"
          ],
          "template": "to pick up move-in keys, {assistedStaff} was able to assist.",
          "label": "Pick up move-in keys",
          "id": "pickupMoveInKeys"
        },
        {
          "id": "dropMoveOutKey",
          "label": "Drop move-out key",
          "extraFields": [
            "assistedStaff"
          ],
          "template": "to drop move out key in an express checkout, {assistedStaff} was able to assist."
        },
        {
          "template": "to drop a missing package/item.",
          "id": "dropMissingItem",
          "label": "Drop missing item"
        },
        {
          "template": "to retrieve a package and needed assistance, was able to assist.",
          "id": "assistPackage",
          "label": "Assist with package retrieval."
        }
      ],
      "label": "Resident"
    },
    {
      "label": "Resident Visitor",
      "reasons": [
        {
          "id": "visitingResident",
          "label": "Visiting a resident"
        },
        {
          "label": "Dropping off item(s)",
          "id": "dropOff"
        },
        {
          "id": "pickup",
          "label": "Picking up item(s)"
        },
        {
          "id": "other",
          "label": "Other",
          "extraFields": [
            "customReason"
          ]
        }
      ],
      "fields": [
        "firstName",
        "lastName",
        "unitOrStreetNumber",
        "residentsName",
        "reasonId",
        "note"
      ],
      "id": "residentVisitor"
    },
    {
      "reasons": [
        {
          "label": "Delivered packages (bulk drop)",
          "id": "bulkDrop"
        },
        {
          "label": "Large delivery / freight",
          "id": "largeDelivery"
        },
        {
          "id": "pickupReturns",
          "label": "Picked up returns"
        },
        {
          "extraFields": [
            "customReason"
          ],
          "label": "Other",
          "id": "other"
        }
      ],
      "fields": [
        "companyName",
        "storedBy",
        "placedAt",
        "reasonId",
        "note"
      ],
      "id": "delivery",
      "label": "Delivery"
    },
    {
      "reasons": [
        {
          "id": "cleaning",
